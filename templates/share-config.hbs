<div class="stl-body" data-strategy="{{config.strategy}}" data-total="{{total}}">

  <div class="form-group">
    <label>
      {{localize "SHARETHELOAD.Field.Pile"}}
      <i class="fa-solid fa-circle-info stl-info" data-tooltip="{{localize "SHARETHELOAD.Hint.Pile"}}"></i>
    </label>
    <div class="form-fields">
      <select name="pileId">
        {{#each piles}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>
  </div>

  {{#if hasPile}}

  {{#if encumbranceOff}}
    <p class="notification warning">{{localize "SHARETHELOAD.Warn.EncumbranceOff"}}</p>
  {{/if}}

  <fieldset>
    <legend>{{localize "SHARETHELOAD.Legend.Distribution"}}</legend>

    <div class="form-group">
      <label>{{localize "SHARETHELOAD.Field.Enabled"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="enabled" {{checked config.enabled}}>
      </div>
    </div>

    <div class="form-group">
      <label>
        {{localize "SHARETHELOAD.Field.Strategy"}}
        <i class="fa-solid fa-circle-info stl-info stl-manual-only" data-tooltip="{{localize "SHARETHELOAD.Hint.Manual"}}"></i>
      </label>
      <div class="form-fields">
        <select name="strategy">
          {{#each strategies}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
    </div>

    {{#if hasCurrency}}
    <div class="form-group">
      <label>{{localize "SHARETHELOAD.Field.IncludeCurrency"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="includeCurrency" {{checked config.includeCurrency}}>
      </div>
      {{#unless currencyRuleActive}}
        <p class="hint warning">{{localize "SHARETHELOAD.Hint.CurrencyRuleOff"}}</p>
      {{/unless}}
    </div>
    {{/if}}

    <div class="stl-metrics">
      <span class="stl-metric">
        {{localize "SHARETHELOAD.Metric.Items"}} <strong>{{breakdown.items}}</strong>
      </span>
      {{#if showCoin}}
      <span class="stl-metric">
        {{localize "SHARETHELOAD.Metric.Coin"}} <strong>{{breakdown.coin}}</strong>
      </span>
      {{/if}}
      <span class="stl-metric stl-metric-total">
        {{localize "SHARETHELOAD.Metric.Total"}} <strong>{{total}}</strong>
      </span>
    </div>
  </fieldset>

  <fieldset class="stl-bearers-fieldset">
    <legend>
      {{localize "SHARETHELOAD.Legend.Bearers"}}
      <i class="fa-solid fa-circle-info stl-info" data-tooltip="{{localize "SHARETHELOAD.Hint.Bearers"}}"></i>
    </legend>

    <div class="stl-bearer-head">
      <span class="stl-col-bearer">{{localize "SHARETHELOAD.Column.Bearer"}}</span>
      <span class="stl-col-share stl-manual-only">{{localize "SHARETHELOAD.Column.Share"}}</span>
      <span class="stl-col-cap">{{localize "SHARETHELOAD.Column.Capacity"}}</span>
      <span class="stl-col-weight">{{localize "SHARETHELOAD.Column.Weight"}}</span>
    </div>

    <ol class="stl-bearers">
      {{#each bearers}}
      <li class="stl-bearer" data-str="{{this.str}}" data-cap="{{this.capacity}}" data-carried="{{this.carried}}" data-enc="{{this.thresholds.enc}}" data-heavy="{{this.thresholds.heavy}}" data-max="{{this.thresholds.max}}" data-source="{{this.source}}">
        <label class="stl-bearer-label">
          <input type="checkbox" name="members.{{this.id}}" {{checked this.checked}}>
          <img src="{{this.img}}" alt="{{this.name}}" width="28" height="28">
          <span class="stl-bearer-name">{{this.name}}</span>
          {{#if this.isNPC}}
            <i class="fa-solid fa-horse stl-npc" title="{{localize "SHARETHELOAD.NonPlayerBearer"}}"></i>
          {{/if}}
          <span class="stl-source stl-source-{{this.source}}">{{this.sourceLabel}}</span>
        </label>

        {{!-- Kept outside the label so dragging does not toggle the checkbox. --}}
        <div class="stl-slider">
          <input type="range" name="weights.{{this.id}}" min="0" max="100" step="1" value="{{this.weight}}">
        </div>

        <span class="stl-bearer-cap">{{this.capacity}}</span>

        <span class="stl-bearer-share">
          <span class="stl-share-weight">{{this.share}}</span>
          <span class="stl-share-pct"></span>
          {{#if this.applied}}<i class="fa-solid fa-check stl-applied" title="{{localize "SHARETHELOAD.Applied"}}"></i>{{/if}}
        </span>
      </li>
      {{else}}
        <li class="stl-empty">{{localize "SHARETHELOAD.NoBearers"}}</li>
      {{/each}}
    </ol>

    <div class="stl-bearers-footer">
      <span class="stl-allocated stl-manual-only">
        {{localize "SHARETHELOAD.Field.Allocated"}}: <span class="stl-sum">100%</span>
      </span>
      <button type="button" data-action="evenOut" class="stl-manual-only">
        <i class="fa-solid fa-scale-balanced"></i> {{localize "SHARETHELOAD.Button.EvenOut"}}
      </button>
    </div>
  </fieldset>

  <footer class="stl-footer">
    <span class="stl-headroom"></span>
    <button type="submit" data-action="save">
      <i class="fa-solid fa-save"></i> {{localize "SHARETHELOAD.Button.Save"}}
    </button>
    <button type="submit" data-action="apply">
      <i class="fa-solid fa-weight-hanging"></i> {{localize "SHARETHELOAD.Button.Apply"}}
    </button>
    <button type="button" data-action="clear">
      <i class="fa-solid fa-trash"></i> {{localize "SHARETHELOAD.Button.Clear"}}
    </button>
  </footer>

  {{else}}
    <p class="notification warning">{{localize "SHARETHELOAD.NoPiles"}}</p>
  {{/if}}

</div>
